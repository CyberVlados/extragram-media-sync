<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extragram Media Sync"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPermissionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_not_granted"
            android:textAlignment="center"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_permission"
            android:layout_marginBottom="24dp" />

        <!-- Sync & Search Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Sync &amp; Search Status:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for playback..."
            android:textAlignment="center"
            android:textSize="14sp"
            android:textColor="#333333"
            android:padding="12dp"
            android:background="#15000000"
            android:layout_marginBottom="16dp" />

        <!-- Local Cache Info -->
        <TextView
            android:id="@+id/tvCacheCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cached Tracks: 0"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear Local Cache"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logcat filters:\nadb logcat -s ExtragramMediaSync,TrackSyncManager,MusicSearchService"
            android:textAlignment="center"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
